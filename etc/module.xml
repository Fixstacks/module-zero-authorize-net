    Authorize.Net card payments for Zero Checkout (Accept.js "Custom Checkout
    Form" + the official authorizenet/authorizenet SDK; core Magento no longer
    ships an Authorize.Net method).
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="Zero_AuthorizeNet" setup_version="1.0.0">
        <sequence>
            <module name="Magento_Sales"/>
            <module name="Magento_Payment"/>
            <module name="Magento_Checkout"/>
            <module name="Zero_Checkout"/>
        </sequence>
    </module>
</config>
